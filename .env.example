# Optional — only affects Reddit's User-Agent header. You can leave it.
REDDIT_USER_AGENT=wsb-briefing/0.1 (personal market sentiment dashboard)

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gmail SMTP. Use an App Password, not your regular password.
# Generate one at https://myaccount.google.com/apppasswords (2FA must be on).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Comma-separated list of recipients
RECIPIENTS=you@example.com,buddy@example.com

# Optional — only needed when running from cloud IPs that Reddit blocks
# (e.g. GitHub Actions). Sign up at scraperapi.com for a free 5k-req/mo tier.
SCRAPER_API_KEY=
